{
  "name": "erp-postgres-sink-v2",
    "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "connection.url": "jdbc:postgresql://postgres:5432/migration_target",
    "connection.username": "migration",
    "connection.password": "${POSTGRES_PASSWORD}",
    "collection.name.format": "${source.table}",
    "topics.regex": "erp\\.erp\\..*",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "delete.enabled": "true",
    "schema.evolution": "basic"
  }
}
